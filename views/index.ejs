<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Nokos WA & Top-up</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Plus Jakarta Sans', sans-serif; } </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">

    <!-- NAVBAR -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="bg-emerald-500 text-slate-950 font-bold p-2 rounded-xl text-sm">WA</div>
                <span class="font-bold text-lg tracking-wide">NOKOS<span class="text-emerald-400">STORE</span></span>
            </div>
            <div class="flex items-center space-x-3">
                <div class="bg-slate-800 px-3 py-1.5 rounded-full border border-slate-700 text-xs sm:text-sm">
                    Saldo: <span id="saldoDisplay" class="font-bold text-emerald-400">Rp 0</span>
                </div>
                <button onclick="openTopupModal()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-semibold px-3 py-1.5 rounded-xl text-xs sm:text-sm transition shadow-lg shadow-emerald-600/20">
                    + Top Up
                </button>
                <button onclick="checkAdminAccess()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1.5 rounded-xl text-xs border border-slate-700">
                    Admin Panel
                </button>
            </div>
        </div>
    </header>

    <!-- CONTAINER UTAMA -->
    <main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">
        
        <!-- BANNER INFO -->
        <div class="bg-gradient-to-r from-emerald-900/40 to-slate-900 border border-emerald-500/30 rounded-2xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold text-white">OTP Tercepat & Anti-Ban 🔥</h1>
                <p class="text-slate-400 text-xs sm:text-sm mt-1">Pilih nomor virtual reguler atau premium untuk verifikasi WhatsApp instan.</p>
            </div>
            <div class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-4 py-2 rounded-xl text-xs font-medium">
                Status: Server Aktif (99.9%)
            </div>
        </div>

        <!-- FILTER TAB -->
        <div class="flex space-x-2 border-b border-slate-800 pb-3">
            <button onclick="filterNokos('Semua')" id="btnSemua" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-600 text-slate-950 transition">Semua Nokos</button>
            <button onclick="filterNokos('Reguler')" id="btnReguler" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition">Reguler (5k - 10k)</button>
            <button onclick="filterNokos('Premium')" id="btnPremium" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition">Premium Anti-Ban (10k - 20k)</button>
        </div>

        <!-- GRID LIST NOKOS -->
        <div id="nokosGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </main>

    <!-- MODAL LOGIN ADMIN -->
    <div id="adminLoginModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-sm p-6 space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold text-emerald-400">Login Admin</h3>
                <button onclick="closeAdminLoginModal()" class="text-slate-400 hover:text-white">✕</button>
            </div>
            <p class="text-xs text-slate-400">Masukkan akun admin (admin / ramzyy03).</p>
            <form onsubmit="handleAdminLogin(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Username</label>
                    <input type="text" id="adminUser" required placeholder="admin" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Password</label>
                    <input type="password" id="adminPass" required placeholder="••••••••" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500">
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold py-2.5 rounded-xl text-sm transition">
                    Masuk Admin
                </button>
            </form>
        </div>
    </div>

    <!-- ADMIN PANEL MODAL -->
    <div id="adminModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-xl p-6 space-y-4 max-h-[85vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <div class="flex items-center space-x-2">
                    <h3 class="text-lg font-bold text-emerald-400">Admin Panel - Verifikasi Saldo</h3>
                    <button onclick="adminLogout()" class="text-[10px] bg-red-500/10 text-red-400 border border-red-500/20 px-2 py-1 rounded-lg">Logout</button>
                </div>
                <button onclick="closeAdminPanel()" class="text-slate-400 hover:text-white">✕</button>
            </div>
            <p class="text-xs text-slate-400">Daftar pesan masuk permintaan verifikasi saldo dari user:</p>
            <div id="listVerifikasi" class="space-y-3"></div>
        </div>
    </div>

    <!-- MODAL TOP UP & QRIS -->
    <div id="topupModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-md p-6 space-y-5">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold">Top Up Saldo</h3>
                <button onclick="closeTopupModal()" class="text-slate-400 hover:text-white">✕</button>
            </div>
            <div id="stepNominal" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Pilih Nominal Top Up (IDR)</label>
                    <select id="nominalSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500">
                        <option value="10000">Rp 10.000</option>
                        <option value="20000">Rp 20.000</option>
                        <option value="50000">Rp 50.000</option>
                        <option value="100000">Rp 100.000</option>
                    </select>
                </div>
                <button onclick="lanjutQris()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold py-3 rounded-xl text-sm transition">
                    Lanjut Pembayaran QRIS
                </button>
            </div>
            <div id="stepQris" class="space-y-4 hidden text-center">
                <p class="text-xs text-slate-400">Scan QRIS di bawah ini:</p>
                <div class="bg-white p-3 rounded-2xl inline-block mx-auto">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=SIMULASI_PAYMENT_NOKOSSTORE" alt="QRIS" class="mx-auto rounded-lg">
                </div>
                <div class="bg-red-500/10 border border-red-500/30 text-red-400 py-2 rounded-xl text-xs font-semibold">
                    Batas Waktu Bayar: <span id="timerCountdown" class="text-sm font-bold">05:00</span>
                </div>
                <div class="space-y-2 text-left">
                    <label class="block text-xs font-medium text-slate-400">Upload Bukti Transfer</label>
                    <input type="file" id="fileBukti" class="w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-emerald-400">
                </div>
                <button onclick="kirimBuktiTransfer()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold py-3 rounded-xl text-sm transition">
                    Kirim Bukti Transfer ke Admin
                </button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT CONTROLLER -->
    <script>
        let appData = {};
        let currentFilter = 'Semua';
        let timerInterval;
        let isAdminLoggedIn = sessionStorage.getItem('adminAuth') === 'true';

        async function fetchData() {
            const res = await fetch('/api/data');
            appData = await res.json();
            document.getElementById('saldoDisplay').innerText = `Rp ${appData.user.saldo.toLocaleString('id-ID')}`;
            renderNokos();
            if (isAdminLoggedIn) renderVerifikasiAdmin();
        }

        function renderNokos() {
            const grid = document.getElementById('nokosGrid');
            grid.innerHTML = '';
            let filtered = currentFilter === 'Semua' ? appData.nokos : appData.nokos.filter(n => n.tipe === currentFilter);

            filtered.forEach(item => {
                grid.innerHTML += `
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between hover:border-slate-700 transition">
                        <div>
                            <div class="flex justify-between items-start mb-3">
                                <span class="px-2.5 py-1 bg-${item.tipe === 'Premium' ? 'amber-500/10 text-amber-400 border-amber-500/20' : 'emerald-500/10 text-emerald-400 border-emerald-500/20'} border rounded-lg text-xs font-semibold">${item.tipe}</span>
                                <span class="text-xs text-slate-400">${item.status}</span>
                            </div>
                            <h3 class="font-bold text-base text-white">${item.negara}</h3>
                            <p class="text-xs text-slate-400 mt-1">Nomor siap terima OTP WhatsApp</p>
                        </div>
                        <div class="mt-5 pt-4 border-t border-slate-800/60 flex items-center justify-between">
                            <span class="text-emerald-400 font-bold text-sm">Rp ${item.harga.toLocaleString('id-ID')}</span>
                            <button onclick="beliNokos(${item.id})" class="bg-slate-800 hover:bg-emerald-600 hover:text-slate-950 text-white px-4 py-2 rounded-xl text-xs font-semibold transition">
                                Beli Nomor
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function filterNokos(tipe) {
            currentFilter = tipe;
            ['Semua', 'Reguler', 'Premium'].forEach(t => {
                const btn = document.getElementById(`btn${t}`);
                btn.className = t === tipe ? "px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-600 text-slate-950 transition" : "px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition";
            });
            renderNokos();
        }

        async function beliNokos(id) {
            if (!confirm("Yakin ingin membeli nomor ini?")) return;
            const res = await fetch('/api/beli', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idNokos: id })
            });
            const data = await res.json();
            if (data.success) {
                alert(`${data.message}\nSilakan gunakan nomor tersebut.`);
                fetchData();
            } else {
                alert(data.message);
            }
        }

        function checkAdminAccess() {
            if (isAdminLoggedIn) {
                document.getElementById('adminModal').classList.remove('hidden');
                document.getElementById('adminModal').classList.add('flex');
                renderVerifikasiAdmin();
            } else {
                document.getElementById('adminLoginModal').classList.remove('hidden');
                document.getElementById('adminLoginModal').classList.add('flex');
            }
        }

        async function handleAdminLogin(event) {
            event.preventDefault();
            const username = document.getElementById('adminUser').value;
            const password = document.getElementById('adminPass').value;

            const res = await fetch('/api/admin/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();

            if (data.success) {
                isAdminLoggedIn = true;
                sessionStorage.setItem('adminAuth', 'true');
                closeAdminLoginModal();
                checkAdminAccess();
            } else {
                alert(data.message);
            }
        }

        function adminLogout() {
            isAdminLoggedIn = false;
            sessionStorage.removeItem('adminAuth');
            closeAdminPanel();
            alert('Berhasil logout dari Admin.');
        }

        function closeAdminLoginModal() {
            document.getElementById('adminLoginModal').classList.remove('flex');
            document.getElementById('adminLoginModal').classList.add('hidden');
        }

        function closeAdminPanel() {
            document.getElementById('adminModal').classList.remove('flex');
            document.getElementById('adminModal').classList.add('hidden');
        }

        function renderVerifikasiAdmin() {
            const container = document.getElementById('listVerifikasi');
            container.innerHTML = '';

            if (!appData.verifikasi || appData.verifikasi.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-500 text-center py-4">Belum ada pesan verifikasi masuk.</p>`;
                return;
            }

            appData.verifikasi.forEach(v => {
                container.innerHTML += `
                    <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="px-2 py-0.5 bg-blue-500/10 text-blue-400 border border-blue-500/20 rounded text-[10px] font-bold">${v.id}</span>
                                <span class="text-xs font-semibold text-white">${v.nama}</span>
                            </div>
                            <p class="text-sm font-bold text-emerald-400 mt-1">Rp ${v.nominal.toLocaleString('id-ID')}</p>
                            <p class="text-[10px] text-slate-500 mt-0.5">Status: <span class="text-amber-400">${v.status}</span> • ${v.waktu}</p>
                        </div>
                        ${v.status === 'Pending' ? `
                            <div class="flex space-x-2 w-full sm:w-auto">
                                <button onclick="prosesVerif('${v.id}', 'terima')" class="flex-1 sm:flex-none bg-emerald-600 hover:bg-emerald-500 text-slate-950 px-3 py-1.5 rounded-xl text-xs font-bold">Terima</button>
                                <button onclick="prosesVerif('${v.id}', 'tolak')" class="flex-1 sm:flex-none bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold">Tolak</button>
                            </div>
                        ` : '<span class="text-xs text-slate-400 font-medium">Selesai</span>'}
                    </div>
                `;
            });
        }

        async function prosesVerif(id, aksi) {
            const res = await fetch('/api/admin/verifikasi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, aksi })
            });
            const data = await res.json();
            if (data.success) {
                appData = data;
                renderVerifikasiAdmin();
                fetchData();
            }
        }

        function openTopupModal() {
            document.getElementById('topupModal').classList.remove('hidden');
            document.getElementById('topupModal').classList.add('flex');
            document.getElementById('stepNominal').classList.remove('hidden');
            document.getElementById('stepQris').classList.add('hidden');
        }

        function closeTopupModal() {
            document.getElementById('topupModal').classList.remove('flex');
            document.getElementById('topupModal').classList.add('hidden');
            clearInterval(timerInterval);
        }

        function lanjutQris() {
            document.getElementById('stepNominal').classList.add('hidden');
            document.getElementById('stepQris').classList.remove('hidden');
            mulaiTimer(300);
        }

        function mulaiTimer(detik) {
            clearInterval(timerInterval);
            let sisa = detik;
            timerInterval = setInterval(() => {
                let m = Math.floor(sisa / 60);
                let s = sisa % 60;
                document.getElementById('timerCountdown').innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                if (sisa <= 0) {
                    clearInterval(timerInterval);
                    alert('Waktu pembayaran habis!');
                    closeTopupModal();
                }
                sisa--;
            }, 1000);
        }

        async function kirimBuktiTransfer() {
            const nominal = document.getElementById('nominalSelect').value;
            const res = await fetch('/api/topup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ nominal, bukti: "bukti.jpg" })
            });
            const data = await res.json();
            if (data.success) {
                alert(`Bukti terkirim! Kode tiket: ${data.code}`);
                closeTopupModal();
                fetchData();
            }
        }

        fetchData();
    </script>
</body>
</html>
